{
  "name": "societyrecord",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "depcruise": "depcruise apps packages --config .dependency-cruiser.cjs",
    "db:migrate": "node --experimental-strip-types tools/migrate.ts",
    "db:reset": "node --experimental-strip-types tools/migrate.ts --reset",
    "gates": "pnpm typecheck && pnpm lint && pnpm depcruise && pnpm test && pnpm smoke",
    "smoke": "node --experimental-strip-types tools/smoke-boot.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "dependency-cruiser": "^16.9.0",
    "eslint": "^9.18.0",
    "pg": "^8.13.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.0.2"
  }
}
