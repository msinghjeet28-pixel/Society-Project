# Local development. Render injects these from render.yaml in deployed services.
DATABASE_URL=postgresql://localhost:5432/societyrecord_dev
PORT=3000
LOG_LEVEL=info
PG_POOL_MAX=10

# DLT-registered Indian SMS provider for OTP (Arch §07). Week-1 critical path:
# registration routinely takes 2–4 weeks and gates every login.
SMS_PROVIDER_KEY=

JWT_SIGNING_KEY=
